{
  "name": "kimi-mcp-connectors",
  "version": "0.2.0",
  "description": "Personal MCP connectors for Context7, Wigolo, and LoreWiki.",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "startupTimeoutMs": 30000,
      "toolTimeoutMs": 120000
    },
    "wigolo": {
      "command": "npx",
      "args": ["-y", "wigolo"],
      "startupTimeoutMs": 120000,
      "toolTimeoutMs": 120000
    },
    "lorewiki": {
      "command": "lorewiki",
      "args": ["mcp", "serve"],
      "startupTimeoutMs": 30000,
      "toolTimeoutMs": 120000
    }
  },
  "interface": {
    "displayName": "Kimi MCP Connectors",
    "shortDescription": "Context7 docs, Wigolo web search, and LoreWiki local knowledge MCP servers."
  }
}

{
  "name": "kimi-mcp-connectors",
  "version": "0.1.0",
  "description": "Personal MCP connectors for Context7, Exa, and LoreWiki.",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "startupTimeoutMs": 30000,
      "toolTimeoutMs": 120000
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "startupTimeoutMs": 30000,
      "toolTimeoutMs": 120000
    },
    "lorewiki": {
      "command": "lorewiki",
      "args": ["mcp", "serve"],
      "startupTimeoutMs": 30000,
      "toolTimeoutMs": 120000
    }
  },
  "interface": {
    "displayName": "Kimi MCP Connectors",
    "shortDescription": "Context7 docs, Exa web search, and LoreWiki local knowledge MCP servers."
  }
}
